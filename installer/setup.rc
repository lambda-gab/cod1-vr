#include "setup_res.h"
// Mod files embedded in the setup; build.bat produces them in ..\proxy\out
IDR_OPENGL32      RCDATA "..\proxy\out\opengl32.dll"
IDR_OPENXR_LOADER RCDATA "..\proxy\out\openxr_loader.dll"
IDR_COD_VR_INI    RCDATA "..\proxy\cod_vr.ini"
// the launcher, built by ..\launcher\build_launcher.bat
IDR_LAUNCHER      RCDATA "..\launcher\out\CoD-VR-Launcher.exe"

1 VERSIONINFO
FILEVERSION 1,6,4,0
PRODUCTVERSION 1,6,4,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Call of Duty VR setup"
      VALUE "ProductName", "Call of Duty VR"
      VALUE "FileVersion", "1.6.4"
      VALUE "ProductVersion", "1.6.4"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
